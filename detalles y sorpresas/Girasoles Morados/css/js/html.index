  </div>
    <div class="ramo">
  <img src="https://github.com/Baque2005/Organizador/blob/master/unnamed%20(1).png?raw=true" alt="Ramo de flores">
    <div class="montes">
      <svg class="monte monte-izq" viewBox="0 0 120 60" width="120" height="60">
        <path d="M0,60 Q30,10 60,60 Q90,30 120,60 Z" fill="#4a7c23" opacity="0.85"/>
        <path d="M10,60 Q35,25 60,60 Q80,40 110,60 Z" fill="#6b8e23" opacity="0.7"/>
      </svg>
      <svg class="monte monte-der" viewBox="0 0 120 60" width="120" height="60">
        <path d="M0,60 Q30,30 60,60 Q90,10 120,60 Z" fill="#4a7c23" opacity="0.85"/>
        <path d="M10,60 Q40,40 60,60 Q85,25 110,60 Z" fill="#8fcf5a" opacity="0.7"/>
      </svg>
    </div>
  </div>
    <script src="js/main.js"></script>
    </body>
</html>